<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_fallback_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_root_background" />

    <LinearLayout
        android:id="@+id/widget_fallback_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/fallback_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="byLife"
            android:textColor="#262626"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fallback_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="読み込んでいます…"
            android:textColor="#746F64"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
