<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <ImageView
        android:id="@+id/row_node"
        android:layout_width="28dp"
        android:layout_height="24dp"
        android:padding="4dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_circle" />

    <LinearLayout
        android:id="@+id/row_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="9dp"
        android:paddingTop="4dp"
        android:paddingEnd="9dp"
        android:paddingBottom="4dp"
        android:background="@drawable/widget_card_background">

        <TextView
            android:id="@+id/row_time"
            android:layout_width="34dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#746F64"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/row_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#262626"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/row_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#A84B3C"
            android:textSize="8sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
